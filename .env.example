# Every variable here is optional.
#
# An endpoint created with this file empty — or with no environment at all —
# boots on the default profile and serves requests. That is a supported
# production configuration, not a shortcut, and it is the case the test suite
# exercises first.
#
# Copy to .env only if you want to change something.


# ---------------------------------------------------------------------------
# Tier 1 — the one thing most deployments set
# ---------------------------------------------------------------------------

# Which model to serve. Everything downstream — sampler, steps, guidance, text
# encoder, VAE, reference limits — follows from this single value.
#
#   klein-4b            distilled, fp8    baked into the image (default)
#   klein-4b-bf16       distilled, bf16   7.8 GB download on first boot
#   klein-4b-nvfp4      distilled, NVFP4  Blackwell GPUs only (cc >= 12.0)
#   klein-4b-base       base, fp8         slower, better prompt adherence
#   klein-4b-base-bf16  base, bf16        the quality ceiling of this family
#
# Unset uses the default. An unknown value fails startup on purpose: a typo
# must never silently deploy a different model.
# FLUX2_VARIANT=klein-4b


# ---------------------------------------------------------------------------
# Tier 2 — endpoint policy
# ---------------------------------------------------------------------------

# Text-encoder precision: bf16 (8.0 GB, baked in) or fp4 (3.8 GB, downloads).
# The encoder sets the memory floor for every profile, so this is the only
# lever that lowers it.
# FLUX2_TEXT_ENCODER=bf16

# Where weights come from: auto | baked | volume | download.
# auto tries the image, then /runpod-volume/models, then Hugging Face. The
# explicit values turn that fallback off so a deployment can assert its
# assumption rather than discover a multi-gigabyte download in its bill.
# MODEL_SOURCE=auto

# Defaults applied when a request omits them.
# DEFAULT_WIDTH=1024
# DEFAULT_HEIGHT=1024
#
# Steps for requests that do not set their own. Unset (or 0) means "follow the
# profile": 4 for the distilled models, 28 for the base ones. The distilled
# models are trained to converge at 4, so raising it there changes the image
# rather than improving it and costs proportionally more; the startup log says
# so if you do. A request may always override it per image.
# DEFAULT_STEPS=
# DEFAULT_OUTPUT_FORMAT=webp
# DEFAULT_OUTPUT_QUALITY=95

# Ceilings. Lower them to keep a shared endpoint predictable.
# MAX_PIXELS=4194304
# MAX_IMAGES_PER_REQUEST=4
# MAX_INPUT_IMAGES=6
# REF_MAX_PIXELS=1048576


# ---------------------------------------------------------------------------
# Optional S3 output
# ---------------------------------------------------------------------------
# Leave all three empty to get base64 back, which is the primary path. Set all
# three together or none of them; a partial configuration fails at startup
# rather than at the first large response.
# BUCKET_ENDPOINT_URL=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=


# ---------------------------------------------------------------------------
# Tier 3 — expert overrides
# ---------------------------------------------------------------------------
# Point the worker at a different checkpoint without forking it. Set each
# _REPO and _FILE pair together. The file must be .safetensors: there is no
# GGUF loader in this image.
#
# Nothing here is validated beyond that, and no checksum is pinned for an
# overridden asset — it is your file, so the worker can only check that it
# arrives, not that it is the right one. Licence compliance is yours too.
# DIFFUSION_MODEL_REPO=
# DIFFUSION_MODEL_FILE=
# TEXT_ENCODER_REPO=
# TEXT_ENCODER_FILE=
# VAE_REPO=
# VAE_FILE=

# Only for an override that points at a gated repository. No built-in profile
# needs this: every model this worker ships is public and Apache-2.0.
# HF_TOKEN=
