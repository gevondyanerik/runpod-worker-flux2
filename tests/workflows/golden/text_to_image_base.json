        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "guider": {
    "_meta": {
      "title": "FLUX2_GUIDER"
    },
    "class_type": "CFGGuider",
    "inputs": {
      "cfg": 5.0,
      "model": [
        "unet",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "positive": [
        "prompt",
        0
      ]
    }
  },
  "latent": {
    "_meta": {
      "title": "FLUX2_LATENT"
    },
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "batch_size": 1,
      "height": 1024,
      "width": 1024
    }
  },
  "negative": {
    "_meta": {
      "title": "FLUX2_NEGATIVE"
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": ""
    }
  },
  "noise": {
    "_meta": {
      "title": "FLUX2_NOISE"
    },
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "prompt": {
    "_meta": {
      "title": "FLUX2_PROMPT"
    },
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "a red bicycle leaning on a wall"
    }
  },
  "sample": {
    "_meta": {
      "title": "FLUX2_SAMPLE"
    },
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "guider": [
        "guider",
        0
      ],
      "latent_image": [
