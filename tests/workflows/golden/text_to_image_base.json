      "title": "FLUX2_TE_LOADER"
    },
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "device": "default",
      "type": "flux2"
    }
  },
  "decode": {
    "_meta": {
      "title": "FLUX2_DECODE"
    },
    "class_type": "VAEDecode",
    "inputs": {
