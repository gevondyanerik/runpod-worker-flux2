        0
      ],
      "noise": [
        "noise",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ]
    }
  },
  "sampler": {
    "_meta": {
      "title": "FLUX2_SAMPLER"
    },
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
